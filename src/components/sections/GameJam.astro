---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getOrdered } from '@/lib/utils';

const [project] = await getOrdered('proyectos');
const { data } = project;
---

<section id="gamejam" class="gamejam" aria-labelledby="gamejam-title">
  <div class="container gamejam__grid">
    <div class="gamejam__cover" data-reveal>
      <Image src={data.cover} alt={data.coverAlt} widths={[400, 700, 1000]} sizes="(min-width: 960px) 480px, 90vw" />
    </div>

    <div class="gamejam__body">
      <span class="kicker" data-reveal><span class="gamejam__index">06</span> {data.event}</span>
      <h2 id="gamejam-title" class="striped" data-reveal>{data.title.toUpperCase()}</h2>
      <div class="gamejam__text" data-reveal>
        {data.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <div class="gamejam__learnings" data-reveal>
        <h3>Aprendizajes clave</h3>
        <ul role="list">
          {
            data.learnings.map((l) => (
              <li>
                <Icon name="lucide:check" aria-hidden="true" /> {l}
              </li>
            ))
          }
        </ul>
      </div>

      <a href={data.url} class="btn btn--accent" target="_blank" rel="noopener noreferrer" data-reveal>
        <Icon name="lucide:gamepad-2" aria-hidden="true" />
        {data.linkLabel}
        <Icon name="lucide:arrow-up-right" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<style>
  /* Sección siempre oscura, en ambos temas */
  .gamejam {
    --ink: #f3ede4;
    --ink-soft: #c3ccd6;
    --muted: #8fa1b3;
    --line: rgb(255 255 255 / 0.14);
    --accent: #ff7452;
    --accent-ink: #ff9475;
    --on-accent: #15171b;
    position: relative;
    padding-block: clamp(72px, 10vw, 128px);
    background:
      radial-gradient(ellipse at 85% 0%, rgb(255 116 82 / 0.18), transparent 55%),
      radial-gradient(ellipse at 0% 100%, rgb(140 198 242 / 0.12), transparent 50%),
      #0b2236;
    color: var(--ink);
    overflow: hidden;
  }

  .gamejam__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: center;
  }

  .gamejam__cover {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7);
    rotate: 2deg;
    transition: rotate 0.6s var(--ease);
  }

  .gamejam__cover:hover {
    rotate: 0deg;
  }

  .gamejam__cover img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .gamejam__body {
    display: grid;
    justify-items: start;
    gap: 22px;
  }

  .gamejam__index {
    color: var(--muted);
  }

  h2 {
    --stripe-color: var(--ink);
    font-size: clamp(2.6rem, 1.6rem + 4.5vw, 5.4rem);
    line-height: 1;
    padding-block: 0.05em;
  }

  .gamejam__text {
    display: grid;
    gap: 14px;
    color: var(--ink-soft);
    font-size: 1.06rem;
  }

  .gamejam__learnings {
    width: 100%;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.04);
  }

  h3 {
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .gamejam__learnings ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 10px 20px;
  }

  .gamejam__learnings li {
    display: flex;
    gap: 10px;
    align-items: start;
  }

  .gamejam__learnings svg {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 4px;
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .gamejam__grid {
      grid-template-columns: 1fr;
    }

    .gamejam__cover {
      max-width: 420px;
      rotate: none;
    }
  }
</style>
