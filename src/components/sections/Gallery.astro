---
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SectionHeading from '@/components/SectionHeading.astro';
import { galleryCategories } from '@/data/site';
import { getOrdered } from '@/lib/utils';

const entries = await getOrdered('galeria');

const sizes = {
  wide: '(min-width: 960px) 800px, 100vw',
  tall: '(min-width: 960px) 400px, (min-width: 640px) 50vw, 100vw',
  normal: '(min-width: 960px) 400px, (min-width: 640px) 50vw, 100vw',
};

const items = await Promise.all(
  entries.map(async ({ id, data }) => {
    const { width, height, format } = data.image;
    const ratio = width / height;
    const shape: keyof typeof sizes = ratio >= 1.7 ? 'wide' : ratio <= 0.8 ? 'tall' : 'normal';
    // Versión grande para el lightbox: lado largo de 1800 px como máximo
    const fullWidth = Math.min(width, ratio >= 1 ? 1800 : Math.round(1800 * ratio));
    const full = await getImage({ src: data.image, width: fullWidth, format: 'webp' });
    return { id, data, shape, animated: format === 'gif', full };
  }),
);

---

<section id="galeria" class="section section--alt" aria-labelledby="galeria-title">
  <div class="container">
    <div class="gallery__head">
      <SectionHeading index="03" kicker="Galería" title="Piezas, estudios y experimentos" id="galeria-title" />
      <div class="filters" role="group" aria-label="Filtrar galería" data-reveal>
        {
          galleryCategories.map((c, i) => (
            <button type="button" class="filter" data-filter={c.value} aria-pressed={i === 0 ? 'true' : 'false'}>
              {c.label}
            </button>
          ))
        }
      </div>
    </div>

    <ul class="gallery" role="list" data-gallery>
      {
        items.map(({ id, data, shape, animated, full }, i) => (
          <li class:list={['gallery__item', `gallery__item--${shape}`]} data-category={data.category} style={`view-transition-name: g-${id}`}>
            <button
              type="button"
              class="gallery__btn"
              data-full={full.src}
              data-title={data.title}
              data-tag={data.tag}
              data-alt={data.alt}
              aria-label={`Ampliar: ${data.title}`}
            >
              <Image
                src={data.image}
                alt={data.alt}
                widths={shape === 'wide' ? [600, 900, 1300] : [400, 600, 800]}
                sizes={sizes[shape]}
                loading={i < 3 ? 'eager' : 'lazy'}
              />
              {animated && (
                <span class="gallery__badge">
                  <Icon name="lucide:play" aria-hidden="true" /> Animación
                </span>
              )}
              <span class="gallery__caption">
                <span class="gallery__title">{data.title}</span>
                <span class="gallery__tag">{data.tag}</span>
              </span>
              <span class="gallery__zoom" aria-hidden="true">
                <Icon name="lucide:maximize-2" />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="lightbox" aria-label="Visor de imágenes" data-lightbox>
    <div class="lightbox__frame" tabindex="-1" autofocus>
      <figure class="lightbox__figure">
        <img alt="" data-lightbox-img />
        <figcaption>
          <span class="lightbox__title" data-lightbox-title></span>
          <span class="lightbox__tag" data-lightbox-tag></span>
          <span class="lightbox__count" data-lightbox-count></span>
        </figcaption>
      </figure>
      <button type="button" class="lightbox__btn lightbox__close" aria-label="Cerrar" data-lightbox-close>
        <Icon name="lucide:x" aria-hidden="true" />
      </button>
      <button type="button" class="lightbox__btn lightbox__prev" aria-label="Anterior" data-lightbox-prev>
        <Icon name="lucide:chevron-left" aria-hidden="true" />
      </button>
      <button type="button" class="lightbox__btn lightbox__next" aria-label="Siguiente" data-lightbox-next>
        <Icon name="lucide:chevron-right" aria-hidden="true" />
      </button>
    </div>
  </dialog>
</section>

<style>
  .gallery__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 0 32px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .filter {
    min-height: 40px;
    padding: 8px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-soft);
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .filter:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .filter[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  /* Mosaico: las piezas panorámicas ocupan 2×2 y las verticales 1×2 */
  .gallery {
    --cols: 3;
    --gap: 16px;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-auto-rows: min(calc((100vw - 2 * var(--gutter) - (var(--cols) - 1) * var(--gap)) / var(--cols) / 1.4), 275px);
    grid-auto-flow: dense;
    gap: var(--gap);
  }

  .gallery__item[hidden] {
    display: none;
  }

  .gallery__item--wide {
    grid-column: span 2;
    grid-row: span 2;
  }

  .gallery__item--tall {
    grid-row: span 2;
  }

  .gallery__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    cursor: zoom-in;
    isolation: isolate;
  }

  /* Fondo blanco tipo papel para los dibujos/GIF con transparencia */
  .gallery__btn img,
  .lightbox__figure img {
    background: #fff;
  }

  .gallery__btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s var(--ease);
  }

  .gallery__btn:hover img,
  .gallery__btn:focus-visible img {
    scale: 1.04;
  }

  .gallery__caption {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 2px;
    padding: 40px 18px 16px;
    background: linear-gradient(to top, rgb(10 12 16 / 0.82), transparent);
    color: #fff;
    text-align: left;
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity 0.3s var(--ease),
      translate 0.3s var(--ease);
  }

  .gallery__btn:hover .gallery__caption,
  .gallery__btn:focus-visible .gallery__caption {
    opacity: 1;
    translate: 0 0;
  }

  .gallery__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .gallery__tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .gallery__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgb(10 12 16 / 0.6);
    backdrop-filter: blur(6px);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
  }

  .gallery__badge svg {
    width: 10px;
    height: 10px;
    fill: currentColor;
  }

  .gallery__zoom {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    opacity: 0;
    scale: 0.8;
    transition:
      opacity 0.3s,
      scale 0.3s var(--ease);
  }

  .gallery__zoom svg {
    width: 16px;
    height: 16px;
  }

  .gallery__btn:hover .gallery__zoom,
  .gallery__btn:focus-visible .gallery__zoom {
    opacity: 1;
    scale: 1;
  }

  /* En pantallas táctiles no hay hover: el pie se ve siempre */
  @media (hover: none) {
    .gallery__caption {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (max-width: 960px) {
    .gallery {
      --cols: 2;
    }
  }

  @media (max-width: 600px) {
    .gallery {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }

    .gallery__item--wide,
    .gallery__item--tall {
      grid-column: auto;
      grid-row: auto;
    }

    .gallery__btn img {
      height: auto;
      max-height: 80vh;
    }
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
  }

  .lightbox::backdrop {
    background: rgb(8 10 14 / 0.95);
    backdrop-filter: blur(6px);
  }

  .lightbox[open] {
    animation: lightbox-in 0.25s var(--ease);
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      scale: 0.98;
    }
  }

  .lightbox__frame {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    outline: none;
    padding: 64px clamp(16px, 8vw, 96px) 24px;
  }

  .lightbox__figure {
    display: grid;
    justify-items: center;
    gap: 16px;
    max-height: 100%;
  }

  .lightbox__figure img {
    max-width: 100%;
    max-height: calc(100dvh - 160px);
    width: auto;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.6);
  }

  .lightbox figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 6px 14px;
    text-align: center;
  }

  .lightbox__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .lightbox__tag,
  .lightbox__count {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: rgb(255 255 255 / 0.65);
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    transition: background-color 0.2s;
  }

  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.2);
  }

  .lightbox__btn svg {
    width: 22px;
    height: 22px;
  }

  .lightbox__close {
    top: 12px;
    right: 12px;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__prev {
    left: clamp(8px, 2vw, 24px);
  }

  .lightbox__next {
    right: clamp(8px, 2vw, 24px);
  }

  @media (max-width: 600px) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 16px;
      translate: none;
    }

    .lightbox__frame {
      padding-bottom: 80px;
    }

    .lightbox__figure img {
      max-height: calc(100dvh - 220px);
    }
  }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]')!;
  const items = [...gallery.querySelectorAll<HTMLLIElement>('.gallery__item')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];

  // ---- Filtros ----
  const applyFilter = (value: string) => {
    filters.forEach((f) => f.setAttribute('aria-pressed', String(f.dataset.filter === value)));
    items.forEach((item) => {
      item.hidden = value !== 'all' && item.dataset.category !== value;
    });
  };

  filters.forEach((button) =>
    button.addEventListener('click', () => {
      const value = button.dataset.filter!;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (document.startViewTransition && !reduce) {
        document.startViewTransition(() => applyFilter(value));
      } else {
        applyFilter(value);
      }
    }),
  );

  // ---- Lightbox ----
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
  const title = dialog.querySelector<HTMLElement>('[data-lightbox-title]')!;
  const tag = dialog.querySelector<HTMLElement>('[data-lightbox-tag]')!;
  const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;

  let visible: HTMLButtonElement[] = [];
  let current = 0;
  let opener: HTMLButtonElement | null = null;

  const show = (index: number) => {
    current = (index + visible.length) % visible.length;
    const btn = visible[current];
    img.src = btn.dataset.full!;
    img.alt = btn.dataset.alt!;
    title.textContent = btn.dataset.title!;
    tag.textContent = btn.dataset.tag!;
    count.textContent = `${current + 1} / ${visible.length}`;
  };

  gallery.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.gallery__btn');
    if (!btn) return;
    visible = items.filter((i) => !i.hidden).map((i) => i.querySelector<HTMLButtonElement>('.gallery__btn')!);
    opener = btn;
    show(visible.indexOf(btn));
    dialog.showModal();
  });

  dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(current + 1));
  dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());

  // Clic fuera de la imagen = cerrar
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || (e.target as HTMLElement).classList.contains('lightbox__frame')) dialog.close();
  });

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // Deslizar en móvil
  let touchX = 0;
  dialog.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) show(dx > 0 ? current - 1 : current + 1);
  });

  dialog.addEventListener('close', () => {
    img.removeAttribute('src');
    opener?.focus();
  });
</script>
